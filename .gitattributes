# Normalize line endings to LF in repository, auto-convert on checkout
* text=auto eol=lf

# Explicitly LF for source files
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Binary — never convert
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text eol=lf
*.webp  binary
*.glb   binary
*.gltf  text eol=lf
*.hdr   binary
*.exr   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
